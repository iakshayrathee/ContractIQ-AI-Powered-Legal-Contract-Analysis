# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# --- OpenAI Models (optional, shown with defaults) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_ANALYSIS=gpt-4o
OPENAI_MODEL_JUDGE=gpt-4o              # Model for LLM-as-Judge evaluation
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_TEMPERATURE=0.0

# --- Guardrails & Judge (optional) ---
GUARDRAILS_ENABLED=true                # Enable input/output guardrails
JUDGE_ENABLED=true                     # Enable LLM-as-Judge evaluation
JUDGE_QUALITY_THRESHOLD=0.7            # Minimum acceptable judge score (0.0-1.0)
GUARDRAIL_HALLUCINATION_THRESHOLD=0.25 # Min source-overlap for extracted clauses

# --- Risk Scoring Weights (Phase 4 — calibrated, configurable) ---
RISK_RULE_WEIGHT=0.4                   # Weight for deterministic rule-layer score (0.0-1.0)
RISK_LLM_WEIGHT=0.6                    # Weight for LLM evidence-grounded score (0.0-1.0)
RISK_SEVERITY_LOW=10                   # Score contribution for LOW severity risks
RISK_SEVERITY_MEDIUM=35                # Score contribution for MEDIUM severity risks
RISK_SEVERITY_HIGH=65                  # Score contribution for HIGH severity risks
RISK_SEVERITY_CRITICAL=90              # Score contribution for CRITICAL severity risks
RISK_DEFAULT_PERSPECTIVE=neutral       # Party perspective: neutral | customer | vendor

# --- Fine-Tuning (optional) ---
OPENAI_MODEL_FINETUNED=contractiq-ft-v1  # Azure deployment name for fine-tuned model
USE_FINETUNED_MODEL=true                # Set to true to use fine-tuned model for Pass 1 extraction
FINETUNING_JUDGE_THRESHOLD=0.85        # Judge score threshold for silver label eligibility (0.0-1.0)
ACTIVE_LEARNING_THRESHOLD=0.75         # Judge score threshold for active learning review queue (0.0-1.0)

# --- Unstructured Cloud API (REQUIRED — all PDFs use cloud extraction) ---
UNSTRUCTURED_API_KEY=your-unstructured-api-key-here   # get a free key at https://unstructured.io/
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io   # optional, this is the default

# --- Chunking ---
CHUNK_MAX_CHARACTERS=3000
CHUNK_NEW_AFTER_N_CHARS=2400
CHUNK_COMBINE_UNDER_N_CHARS=500
# Fix 2: Increased from 512→1024 (legal clauses exceed 512 chars) and 64→200 (prevent mid-clause splits)
CHUNK_SIZE=1024
CHUNK_OVERLAP=200

# --- Image extraction (multimodal RAG) ---
EXTRACT_IMAGES=true           # Set to false to disable image extraction entirely
IMAGE_MIN_WIDTH=100           # Minimum image width in pixels to process
IMAGE_MIN_HEIGHT=100          # Minimum image height in pixels to process
VISION_CONCURRENCY=3          # Max parallel GPT-4o vision calls during ingestion

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=           # Only needed for Qdrant Cloud

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://contractiq:contractiq@localhost:5432/contractiq

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.20

# --- Langfuse (optional) ---
LANGFUSE_ENABLED=false
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- Application ---
LOG_LEVEL=INFO
